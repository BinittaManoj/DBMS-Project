# MedMart Retail Analytics -- Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:root@localhost:5432/retail_db

# Application settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True

DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
