# Copy this file to .env and replace each placeholder with local values.
# Never commit .env or real credentials.

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/retail_db

# JWT settings (use a unique, randomly generated secret outside local demos)
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Local application settings
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
